# Required to access /admin/product-registrations and its API
ADMIN_ACCESS_KEY=replace-with-a-long-private-key

# Cashfree Payment Gateway Credentials
# Sandbox keys: https://sandbox.cashfree.com
# Production keys: https://merchant.cashfree.com
CASHFREE_APP_ID=TEST_YOUR_APP_ID
CASHFREE_SECRET_KEY=TEST_YOUR_SECRET_KEY
CASHFREE_ENV=sandbox
NEXT_PUBLIC_CASHFREE_ENV=sandbox
CASHFREE_API_VERSION=2023-08-01

# Base URL for payment return_url redirects
NEXT_PUBLIC_BASE_URL=http://localhost:3000
